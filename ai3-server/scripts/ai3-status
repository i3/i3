#!/usr/bin/env python3
"""
ai3-status: Wrapper around i3status that adds AI branding, keybind hints,
pending suggestion display, and auto mode status.
"""

import json
import os
import subprocess
import sys
import urllib.request
import urllib.error

# Suggestion file location
SUGGESTION_FILE = "/tmp/ai3-suggestion.json"

# Server URL
SERVER_URL = os.environ.get("AI3_SERVER_URL", "http://localhost:7878")

# AI keybind documentation (shown in bar)
AI_KEYBINDS = [
    ("Ctrl+Shift+S", "Suggest"),
    ("Ctrl+Shift+O", "Optimize"),
    ("Ctrl+Shift+C", "Chat"),
    ("Ctrl+Shift+A", "Auto"),
]


def create_branding_block():
    """Create the ai3 branding block."""
    return {
        "name": "ai3_brand",
        "full_text": "🤖 ai3 - AI Powered i3wm",
        "short_text": "ai3",
        "color": "#bd93f9",  # Dracula purple
        "separator": True,
        "separator_block_width": 20,
    }


def create_keybind_blocks():
    """Create blocks showing AI keybindings."""
    blocks = []
    for key, action in AI_KEYBINDS:
        blocks.append({
            "name": f"ai3_key_{action.lower().replace(' ', '_')}",
            "full_text": f"{key}={action}",
            "short_text": key.split("+")[-1],
            "color": "#6272a4",  # Dracula comment (dimmed)
            "separator": True,
            "separator_block_width": 12,
        })
    return blocks


def get_auto_mode_status():
    """Check if auto mode is running."""
    try:
        req = urllib.request.Request(f"{SERVER_URL}/auto/status", method="GET")
        with urllib.request.urlopen(req, timeout=1) as resp:
            data = json.loads(resp.read().decode())
            return data.get("state", {})
    except (urllib.error.URLError, json.JSONDecodeError, TimeoutError):
        return None


def create_auto_mode_blocks(auto_state):
    """Create blocks showing auto mode status."""
    status = auto_state.get("status", "idle")
    goal = auto_state.get("goal", "")[:30]
    actions = auto_state.get("actions_taken", 0)
    reasoning = auto_state.get("last_reasoning", "")[:40]

    blocks = []

    if status == "running":
        # Auto mode is active - show prominent indicator
        blocks.append({
            "name": "ai3_auto_active",
            "full_text": f"🤖 AUTO MODE ACTIVE",
            "short_text": "AUTO",
            "color": "#ff79c6",  # Dracula pink
            "background": "#282a36",  # Dracula background
            "separator": True,
            "separator_block_width": 10,
            "urgent": True,
        })

        if reasoning:
            blocks.append({
                "name": "ai3_auto_reasoning",
                "full_text": f"💭 {reasoning}",
                "short_text": "...",
                "color": "#f8f8f2",  # Dracula foreground
                "separator": True,
                "separator_block_width": 10,
            })

        blocks.append({
            "name": "ai3_auto_actions",
            "full_text": f"Actions: {actions}",
            "short_text": str(actions),
            "color": "#8be9fd",  # Dracula cyan
            "separator": True,
            "separator_block_width": 10,
        })

        # Stop hint
        blocks.append({
            "name": "ai3_auto_stop",
            "full_text": "Ctrl+Shift+Esc=STOP",
            "short_text": "Esc",
            "color": "#ff5555",  # Red for stop
            "separator": True,
            "separator_block_width": 15,
        })

    elif status == "stopping":
        blocks.append({
            "name": "ai3_auto_stopping",
            "full_text": "🛑 AUTO MODE STOPPING...",
            "short_text": "STOP",
            "color": "#ffb86c",  # Dracula orange
            "separator": True,
            "separator_block_width": 15,
        })

    elif status == "error":
        error = auto_state.get("error", "Unknown error")[:30]
        blocks.append({
            "name": "ai3_auto_error",
            "full_text": f"❌ AUTO ERROR: {error}",
            "short_text": "ERR",
            "color": "#ff5555",  # Dracula red
            "separator": True,
            "separator_block_width": 15,
        })

    return blocks


def get_pending_suggestion():
    """Read pending suggestion from file if exists."""
    if not os.path.exists(SUGGESTION_FILE):
        return None
    try:
        with open(SUGGESTION_FILE, 'r') as f:
            return json.load(f)
    except (json.JSONDecodeError, IOError):
        return None


def create_suggestion_blocks(suggestion):
    """Create blocks showing pending suggestion."""
    desc = suggestion.get('description', 'Unknown action')[:50]
    keys = suggestion.get('keys', '')
    confidence = suggestion.get('confidence', 0)

    blocks = []

    # Suggestion indicator
    blocks.append({
        "name": "ai3_suggestion",
        "full_text": f"💡 {desc}",
        "short_text": "💡",
        "color": "#f1fa8c",  # Dracula yellow
        "separator": True,
        "separator_block_width": 10,
    })

    if keys:
        blocks.append({
            "name": "ai3_suggestion_keys",
            "full_text": f"[{keys}]",
            "short_text": keys,
            "color": "#50fa7b",  # Dracula green
            "separator": True,
            "separator_block_width": 10,
        })

    # Accept/Discard hints
    blocks.append({
        "name": "ai3_accept",
        "full_text": "Ctrl+Shift+Y=Yes",
        "short_text": "Y",
        "color": "#50fa7b",  # Green for accept
        "separator": True,
        "separator_block_width": 8,
    })

    blocks.append({
        "name": "ai3_discard",
        "full_text": "Ctrl+Shift+N=No",
        "short_text": "N",
        "color": "#ff5555",  # Red for discard
        "separator": True,
        "separator_block_width": 15,
    })

    return blocks


def main():
    """Main entry point."""
    # Start i3status subprocess
    i3status_proc = subprocess.Popen(
        ["i3status", "-c", "/root/.config/i3status/config"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        bufsize=1,
    )

    try:
        for line in i3status_proc.stdout:
            line = line.strip()

            # Handle the initial header and version line
            if line.startswith('{"version"'):
                # Pass through the version header
                print(line)
                sys.stdout.flush()
                continue

            if line == "[":
                # Start of array
                print(line)
                sys.stdout.flush()
                continue

            # Handle status lines (JSON arrays)
            if line.startswith("[") or line.startswith(","):
                # Remove leading comma if present
                prefix = ""
                if line.startswith(","):
                    prefix = ","
                    line = line[1:]

                try:
                    # Parse the JSON array
                    blocks = json.loads(line)

                    # Check auto mode status first (highest priority)
                    auto_state = get_auto_mode_status()
                    auto_running = auto_state and auto_state.get(
                        "status") in ["running", "stopping", "error"]

                    if auto_running:
                        # Show auto mode blocks
                        auto_blocks = create_auto_mode_blocks(auto_state)
                        for block in reversed(auto_blocks):
                            blocks.insert(0, block)
                    else:
                        # Check for pending suggestion
                        suggestion = get_pending_suggestion()

                        if suggestion:
                            # Show suggestion blocks instead of regular keybinds
                            suggestion_blocks = create_suggestion_blocks(
                                suggestion)
                            for block in reversed(suggestion_blocks):
                                blocks.insert(0, block)
                        else:
                            # Show regular keybind hints
                            keybind_blocks = create_keybind_blocks()
                            for block in reversed(keybind_blocks):
                                blocks.insert(0, block)

                        # Always show branding (when not in auto mode)
                        branding_block = create_branding_block()
                        blocks.insert(0, branding_block)

                    # Output the modified line
                    output = prefix + json.dumps(blocks)
                    print(output)
                    sys.stdout.flush()
                except json.JSONDecodeError:
                    # If parsing fails, pass through unchanged
                    print(prefix + line)
                    sys.stdout.flush()
            else:
                # Pass through any other lines unchanged
                print(line)
                sys.stdout.flush()

    except KeyboardInterrupt:
        pass
    finally:
        i3status_proc.terminate()


if __name__ == "__main__":
    main()
